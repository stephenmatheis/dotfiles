# hax0r pink-cyan for delta: Pink + cyan.
# Built by `hax0r build` from ~/.config/hax0r/palettes.lua: edit that, not this file.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = none
	true-color = always
	dark = true
	minus-style = "#008281 #14222a"
	minus-emph-style = "#008281 #0f383e"
	plus-style = "#fd5ca7 #482433"
	plus-emph-style = "#fd5ca7 #65394b"
	zero-style = "#fd5ca7"
	file-style = "#fd5ca7 bold"
	file-decoration-style = "#3c1024 ul"
	hunk-header-style = "line-number #de0084"
	hunk-header-line-number-style = "#de0084"
	hunk-header-decoration-style = none
