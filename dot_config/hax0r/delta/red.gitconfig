# hax0r red for delta: HaX0R R3D.
# Built by `hax0r build` from ~/.config/hax0r/palettes.lua: edit that, not this file.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = none
	true-color = always
	dark = true
	minus-style = "#cf1414 #220b0b"
	minus-emph-style = "#cf1414 #3b1b1b"
	plus-style = "#f01e1e #410c0c"
	plus-emph-style = "#f01e1e #601313"
	zero-style = "#f01e1e"
	file-style = "#f01e1e bold"
	file-decoration-style = "#320505 ul"
	hunk-header-style = "line-number #cf1414"
	hunk-header-line-number-style = "#cf1414"
	hunk-header-decoration-style = none
