# hax0r red for delta: HaX0R R3D.
# Built by `hax0r build` from ~/.config/hax0r/palettes.lua: edit that, not this file.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = none
	true-color = always
	dark = true
	minus-style = "#b00d0d #2e0b0b"
	minus-emph-style = "#b00d0d #441b1b"
	plus-style = "#d81010 #4d0404"
	plus-emph-style = "#d81010 #6a0606"
	zero-style = "#d81010"
	file-style = "#d81010 bold"
	file-decoration-style = "#3c0303 ul"
	hunk-header-style = "line-number #b00d0d"
	hunk-header-line-number-style = "#b00d0d"
	hunk-header-decoration-style = none
