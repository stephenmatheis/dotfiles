bell-features = no-attention,no-title
# The hax0r themes live in themes/hax0r-*, built from ~/.config/hax0r/palettes.lua with the
# palette changes Claude Code needs. `hax0r <theme>` writes the file included below and reloads
# Ghostty; until it's run, Gr33N
theme = hax0r-green
config-file = ?~/.local/state/hax0r/ghostty
window-padding-x = 16
window-padding-y = 0,16
window-padding-balance = true
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs
progress-style = false

# Themes I like
# IC Orange PPL
# Kanagawa Dragon
# Miasma

