# default theme if one hasn't been set in the linked file below
theme = hax0r-green

# hax0r themes live in themes/hax0r-*
# built from ~/.config/hax0r/palettes.lua
# run `hax0r` to list the themes and `hax0r <theme>` to switch
config-file = ?~/.local/state/hax0r/ghostty

# window
bell-features = no-attention,no-title
window-padding-x = 16
window-padding-y = 0,16
window-padding-balance = true
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs
progress-style = false

# Themes I like
# IC Orange PPL
# Kanagawa Dragon
# Miasma

