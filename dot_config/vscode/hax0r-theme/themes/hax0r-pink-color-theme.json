    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#de0084", "fontStyle": "italic" }
        },
        {
            "name": "String, Character",
            "scope": ["string", "punctuation.definition.string", "constant.character"],
            "settings": { "foreground": "#fe91bd" }
        },
        {
            "name": "Constant, Number, Boolean",
            "scope": ["constant", "constant.numeric", "constant.language.boolean", "variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#fe91bd" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function", "meta.function-call.generic"],
            "settings": { "foreground": "#fe91bd" }
        },
        {
            "name": "Keyword (Statement)",
            "scope": ["keyword", "keyword.control", "keyword.other", "storage", "storage.type", "storage.modifier", "entity.name.label", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.word", "keyword.operator.logical.python"],
            "settings": { "foreground": "#feabcb", "fontStyle": "bold" }
        },
        {
            "name": "Operator, Delimiter",
            "scope": ["keyword.operator", "punctuation", "storage.type.function.arrow"],
            "settings": { "foreground": "#fd5ca7", "fontStyle": "" }
        },
        {
            "name": "Variable, Property",
            "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name", "meta.embedded", "meta.template.expression"],
            "settings": { "foreground": "#fd5ca7" }
        },
        {
            "name": "Type, Module",
            "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace", "entity.name.type.module", "storage.type.primitive", "storage.type.built-in"],
            "settings": { "foreground": "#feaaca", "fontStyle": "" }
        },
        {
            "name": "Special: builtins, escapes, regex, tags, attributes",
            "scope": ["support.function", "support.constant", "support.variable", "constant.language", "variable.language", "constant.character.escape", "string.regexp", "constant.other.placeholder", "constant.character.entity", "punctuation.definition.template-expression", "punctuation.section.embedded", "entity.name.tag", "punctuation.definition.tag", "entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
            "settings": { "foreground": "#feaaca", "fontStyle": "" }
        },
        {
            "name": "Markup: headings",
            "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
            "settings": { "foreground": "#feabcb", "fontStyle": "bold" }
        },
        {
            "name": "Markup: raw, quote, list markers",
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw", "markup.quote", "punctuation.definition.list"],
            "settings": { "foreground": "#feaaca" }
        },
        {
            "name": "Markup: links",
            "scope": ["markup.underline.link", "string.other.link", "markup.link"],
            "settings": { "foreground": "#fea5ce", "fontStyle": "underline" }
        },
        {
            "name": "Markup: emphasis",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Diff",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#feaaca" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#de0084" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "name": "Error",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#fefefe" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "fontStyle": "strikethrough" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#feaaca",
        "type": "#feaaca",
        "class": "#feaaca",
        "enum": "#feaaca",
        "interface": "#feaaca",
        "struct": "#feaaca",
        "typeParameter": "#feaaca",
        "decorator": "#feaaca",
        "enumMember": "#fe91bd",
        "function": "#fe91bd",
        "function.defaultLibrary": "#fe91bd",
        "method": "#fe91bd",
        "macro": "#fe91bd",
        "string": "#fe91bd",
        "number": "#fe91bd",
        "regexp": "#feaaca",
        "keyword": { "foreground": "#feabcb", "bold": true },
        "comment": { "foreground": "#de0084", "italic": true },
        "operator": "#fd5ca7",
        "parameter": "#fd5ca7",
        "variable": "#fd5ca7",
        "variable.readonly": "#fd5ca7",
        "variable.defaultLibrary": "#fd5ca7",
        "property": "#fd5ca7",
        "*.deprecated": { "strikethrough": true }
    }
}
