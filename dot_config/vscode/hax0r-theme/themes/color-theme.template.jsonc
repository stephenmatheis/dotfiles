// Template for the hax0r VS Code color themes. generate.lua (run `hax0r build`) fills in each
// role in double braces from ~/.config/hax0r/palettes.lua and writes one
// themes/hax0r-<theme>-color-theme.json per theme, so edit this file, not those. A role followed
// by 2 hex digits is that color made see-through, for overlays that must not hide the text under them.
// Comments explain choices in Gr33N's colors, where they were made:
//   bg #020f01, fg #16b10e, dark #001f0b (ansi 0), normal #15d00d (ansi 1-6),
//   bright #19e20e (ansi 9-14), bold #19e30f, white #fafafa, bright_white #fefefe,
//   cursor_text #ffffff, selection #d4ffc1, link #75d868, selection_tint #1b2c18,
//   dim #0b8700 (badge #14ff00 @ 50% over bg), cursor_line #094e05, ignored #0e7009, error #fefefe,
//   warning #8aee84, diff_add #073904, diff_add_word #0a5505, diff_del #0c1d0b, diff_del_word #1c331a.
// Hue mapping for VS Code's own colors: red is error (or removed, for git and diffs), yellow and
// orange are warning, green is bright (or added, for git and diffs), blue is link, purple is selection.
// Chrome borders are #16b10e26, fg at 15%: the faint outline VS Code itself draws around its
// panels. Not nvim's dim WinSeparator/FloatBorder, which looked loud next to those outlines.
{
    "$schema": "vscode://schemas/color-theme",
    "name": "{{label}}",
    "type": "{{type}}",
    "semanticHighlighting": true,
    "colors": {
        // Chrome
        "foreground": "{{fg}}",
        "descriptionForeground": "{{dim}}",
        "disabledForeground": "{{dim}}",
        "errorForeground": "{{error}}",
        "icon.foreground": "{{fg}}",
        "focusBorder": "{{dim}}",
        "selection.background": "{{selection}}1f",
        "widget.shadow": "{{black}}33",
        "scrollbar.shadow": "{{black}}33",
        "sash.hoverBorder": "{{dim}}",
        "titleBar.activeBackground": "{{bg}}",
        "titleBar.activeForeground": "{{fg}}",
        "titleBar.inactiveBackground": "{{bg}}",
        "titleBar.inactiveForeground": "{{dim}}",
        "activityBar.background": "{{bg}}",
        "activityBar.foreground": "{{bright}}",
        "activityBar.inactiveForeground": "{{dim}}",
        "activityBar.activeBorder": "{{bright}}",
        "activityBar.border": "{{fg}}26",
        "activityBarBadge.background": "{{badge}}",
        "activityBarBadge.foreground": "{{bg}}",
        "badge.background": "{{badge}}",
        "badge.foreground": "{{bg}}",
        "sideBar.background": "{{bg}}",
        "sideBar.foreground": "{{fg}}",
        "sideBar.border": "{{fg}}26",
        "sideBarTitle.foreground": "{{bright}}",
        "sideBarSectionHeader.background": "{{dark}}",
        "sideBarSectionHeader.foreground": "{{bright}}",
        "editorGroup.border": "{{fg}}26", // see "Chrome borders" at the top
        "editorGroupHeader.tabsBackground": "{{dark}}",
        "tab.activeBackground": "{{bg}}",
        "tab.activeForeground": "{{bright}}", // not fg like nvim's bold TabLineSel: tabs can't be bold
        "tab.inactiveBackground": "{{dark}}",
        "tab.inactiveForeground": "{{dim}}",
        "tab.unfocusedActiveForeground": "{{fg}}",
        "tab.unfocusedInactiveForeground": "{{dim}}",
        "tab.border": "{{dark}}",
        "tab.lastPinnedBorder": "{{fg}}26",
        "statusBar.background": "{{dark}}",
        "statusBar.foreground": "{{bright}}",
        "statusBar.noFolderBackground": "{{dark}}",
        "statusBar.debuggingBackground": "{{fg}}",
        "statusBar.debuggingForeground": "{{bg}}",
        "statusBarItem.remoteBackground": "{{dark}}",
        "statusBarItem.remoteForeground": "{{bright}}",
        "statusBarItem.hoverBackground": "{{cursor_line}}",
        "statusBarItem.activeBackground": "{{dim}}",
        "statusBarItem.errorBackground": "{{error}}",
        "statusBarItem.errorForeground": "{{bg}}",
        "statusBarItem.warningBackground": "{{warning}}",
        "statusBarItem.warningForeground": "{{bg}}",
        "panel.background": "{{bg}}",
        "panel.border": "{{fg}}26",
        "panelTitle.activeForeground": "{{bright}}",
        "panelTitle.inactiveForeground": "{{dim}}",
        "panelTitle.activeBorder": "{{bright}}",
        "panelSectionHeader.background": "{{dark}}",
        "breadcrumb.foreground": "{{dim}}",
        "breadcrumb.focusForeground": "{{bright}}",
        "breadcrumb.activeSelectionForeground": "{{bright}}",
        "breadcrumbPicker.background": "{{dark}}",
        "textLink.foreground": "{{link}}",
        "textLink.activeForeground": "{{link}}",
        "textPreformat.foreground": "{{bright}}",
        "textPreformat.background": "{{dark}}",
        "textCodeBlock.background": "{{dark}}",
        "textBlockQuote.background": "{{dark}}",
        "textBlockQuote.border": "{{dim}}",
        "textSeparator.foreground": "{{dim}}",
        "progressBar.background": "{{bright}}",

        // Editor
        "editor.background": "{{bg}}",
        "editor.foreground": "{{fg}}",
        "editorCursor.foreground": "{{normal}}",
        "editorCursor.background": "{{cursor_text}}",
        "editorLineNumber.foreground": "{{dim}}",
        "editorLineNumber.activeForeground": "{{bright}}",
        "editor.lineHighlightBackground": "#00000000", // like nvim's cursorlineopt=number: only the number lights up
        "editor.lineHighlightBorder": "#00000000",
        "editorGutter.background": "{{bg}}",
        "editorGutter.foldingControlForeground": "{{dim}}",
        "editor.foldBackground": "{{dark}}",
        "editor.foldPlaceholderForeground": "{{dim}}",
        "editorWhitespace.foreground": "{{dim}}",
        "editorIndentGuide.background1": "{{dim}}",
        "editorIndentGuide.activeBackground1": "{{fg}}",
        "editorRuler.foreground": "{{dark}}",
        "editorLink.activeForeground": "{{link}}",
        "editorCodeLens.foreground": "{{dim}}",
        "editorInlayHint.foreground": "{{dim}}",
        "editorInlayHint.background": "#00000000",
        "editorGhostText.foreground": "{{dim}}",
        "editorLightBulb.foreground": "{{bright}}",
        "editorLightBulbAutoFix.foreground": "{{bright}}",
        "editorStickyScroll.background": "{{dark}}", // like nvim's floats (NormalFloat), where treesitter-context draws the same thing, so stuck lines read as a header
        "editorStickyScrollGutter.background": "{{dark}}",
        "editorStickyScrollHover.background": "{{cursor_line}}",
        "editorStickyScroll.shadow": "{{black}}33",
        "editorOverviewRuler.border": "#00000000",

        // Interaction
        "editor.selectionBackground": "{{selection}}1f", // selection_tint, see-through so it also works on dark_green surfaces
        "editor.inactiveSelectionBackground": "{{selection}}14",
        "editor.selectionHighlightBackground": "{{selection}}14",
        "editor.wordHighlightBackground": "{{selection}}14",
        "editor.wordHighlightStrongBackground": "{{selection}}14",
        "editor.hoverHighlightBackground": "{{selection}}14",
        "editor.findMatchBackground": "{{bright}}",
        "editor.findMatchForeground": "{{bg}}",
        "editor.findMatchHighlightBackground": "{{fg}}",
        "editor.findMatchHighlightForeground": "{{bg}}",
        "editor.findRangeHighlightBackground": "{{cursor_line}}66",
        "editorBracketMatch.background": "#00000000",
        "editorBracketMatch.border": "{{bold}}", // a box, since VS Code can't bold and underline the bracket like nvim's MatchParen
        "editorBracketHighlight.foreground1": "{{bright}}",
        "editorBracketHighlight.foreground2": "{{fg}}",
        "editorBracketHighlight.foreground3": "{{bright}}",
        "editorBracketHighlight.foreground4": "{{fg}}",
        "editorBracketHighlight.foreground5": "{{bright}}",
        "editorBracketHighlight.foreground6": "{{fg}}",
        "editorBracketHighlight.unexpectedBracket.foreground": "{{error}}",
        "list.activeSelectionBackground": "{{fg}}",
        "list.activeSelectionForeground": "{{bg}}",
        "list.activeSelectionIconForeground": "{{bg}}",
        "list.inactiveSelectionBackground": "{{dark}}",
        "list.inactiveSelectionForeground": "{{fg}}",
        "list.focusBackground": "{{dark}}",
        "list.focusOutline": "{{dim}}",
        "list.hoverBackground": "{{cursor_line}}",
        "list.hoverForeground": "{{bright}}",
        "list.highlightForeground": "{{bright}}",
        "list.focusHighlightForeground": "{{bg}}",
        "list.errorForeground": "{{error}}",
        "list.warningForeground": "{{warning}}",
        "list.dropBackground": "{{cursor_line}}",
        "tree.indentGuidesStroke": "{{dim}}",
        "scrollbarSlider.background": "{{dim}}66",
        "scrollbarSlider.hoverBackground": "{{dim}}aa",
        "scrollbarSlider.activeBackground": "{{dim}}",
        "minimap.findMatchHighlight": "{{bright}}",
        "minimap.selectionHighlight": "{{selection}}66",
        "minimap.errorHighlight": "{{error}}",
        "minimap.warningHighlight": "{{warning}}",

        // Messages
        "notifications.background": "{{dark}}",
        "notifications.foreground": "{{fg}}",
        "notifications.border": "{{fg}}26",
        "notificationToast.border": "{{fg}}26",
        "notificationCenterHeader.background": "{{dark}}",
        "notificationLink.foreground": "{{link}}",
        "notificationsErrorIcon.foreground": "{{error}}",
        "notificationsWarningIcon.foreground": "{{warning}}",
        "notificationsInfoIcon.foreground": "{{bright}}",

        // Diagnostics
        "editorError.foreground": "{{error}}",
        "editorWarning.foreground": "{{warning}}",
        "editorInfo.foreground": "{{bright}}",
        "editorHint.foreground": "{{dim}}",
        "problemsErrorIcon.foreground": "{{error}}",
        "problemsWarningIcon.foreground": "{{warning}}",
        "problemsInfoIcon.foreground": "{{bright}}",
        "editorOverviewRuler.errorForeground": "{{error}}",
        "editorOverviewRuler.warningForeground": "{{warning}}",
        "editorOverviewRuler.infoForeground": "{{bright}}",
        "editorMarkerNavigation.background": "{{dark}}",
        "editorMarkerNavigationError.background": "{{error}}",
        "editorMarkerNavigationWarning.background": "{{warning}}",
        "editorMarkerNavigationInfo.background": "{{bright}}",

        // Diff: diff_add, diff_add_word, diff_del and diff_del_word, the same as nvim's and Claude
        // Code's diffs (ghostty slots 22/28/52/88): added bands tinted with the theme's bright and
        // removed bands with white and dim mixed, and dark enough to keep dim comments readable
        "diffEditor.insertedLineBackground": "{{diff_add}}",
        "diffEditor.insertedTextBackground": "{{diff_add_word}}",
        "diffEditor.removedLineBackground": "{{diff_del}}",
        "diffEditor.removedTextBackground": "{{diff_del_word}}",
        "diffEditor.diagonalFill": "{{diff_del}}",
        "diffEditor.border": "{{fg}}26",
        "diffEditor.unchangedRegionBackground": "{{dark}}",
        "diffEditor.unchangedRegionForeground": "{{dim}}",
        "merge.currentHeaderBackground": "{{diff_add_word}}",
        "merge.currentContentBackground": "{{diff_add}}",
        "merge.incomingHeaderBackground": "{{link}}66",
        "merge.incomingContentBackground": "{{link}}26",

        // Git: added is bright, modified white, deleted dim, conflicts warning, ignored fg @ 60% (not
        // dim, which is deleted's color)
        "editorGutter.addedBackground": "{{added}}",
        "editorGutter.modifiedBackground": "{{white}}",
        "editorGutter.deletedBackground": "{{removed}}",
        "editorOverviewRuler.addedForeground": "{{added}}",
        "editorOverviewRuler.modifiedForeground": "{{white}}",
        "editorOverviewRuler.deletedForeground": "{{removed}}",
        "minimapGutter.addedBackground": "{{added}}",
        "minimapGutter.modifiedBackground": "{{white}}",
        "minimapGutter.deletedBackground": "{{removed}}",
        "gitDecoration.addedResourceForeground": "{{added}}",
        "gitDecoration.untrackedResourceForeground": "{{added}}",
        "gitDecoration.modifiedResourceForeground": "{{white}}",
        "gitDecoration.renamedResourceForeground": "{{white}}",
        "gitDecoration.stageModifiedResourceForeground": "{{white}}",
        "gitDecoration.deletedResourceForeground": "{{removed}}",
        "gitDecoration.stageDeletedResourceForeground": "{{removed}}",
        "gitDecoration.conflictingResourceForeground": "{{warning}}",
        "gitDecoration.ignoredResourceForeground": "{{ignored}}",
        "gitDecoration.submoduleResourceForeground": "{{link}}",

        // Symbol icons (breadcrumbs, outline, suggestions): nvim's mini.icons draws every kind in green
        "symbolIcon.arrayForeground": "{{normal}}",
        "symbolIcon.booleanForeground": "{{normal}}",
        "symbolIcon.classForeground": "{{normal}}",
        "symbolIcon.colorForeground": "{{normal}}",
        "symbolIcon.constantForeground": "{{normal}}",
        "symbolIcon.constructorForeground": "{{normal}}",
        "symbolIcon.enumeratorForeground": "{{normal}}",
        "symbolIcon.enumeratorMemberForeground": "{{normal}}",
        "symbolIcon.eventForeground": "{{normal}}",
        "symbolIcon.fieldForeground": "{{normal}}",
        "symbolIcon.fileForeground": "{{normal}}",
        "symbolIcon.folderForeground": "{{normal}}",
        "symbolIcon.functionForeground": "{{normal}}",
        "symbolIcon.interfaceForeground": "{{normal}}",
        "symbolIcon.keyForeground": "{{normal}}",
        "symbolIcon.keywordForeground": "{{normal}}",
        "symbolIcon.methodForeground": "{{normal}}",
        "symbolIcon.moduleForeground": "{{normal}}",
        "symbolIcon.namespaceForeground": "{{normal}}",
        "symbolIcon.nullForeground": "{{normal}}",
        "symbolIcon.numberForeground": "{{normal}}",
        "symbolIcon.objectForeground": "{{normal}}",
        "symbolIcon.operatorForeground": "{{normal}}",
        "symbolIcon.packageForeground": "{{normal}}",
        "symbolIcon.propertyForeground": "{{normal}}",
        "symbolIcon.referenceForeground": "{{normal}}",
        "symbolIcon.snippetForeground": "{{normal}}",
        "symbolIcon.stringForeground": "{{normal}}",
        "symbolIcon.structForeground": "{{normal}}",
        "symbolIcon.textForeground": "{{normal}}",
        "symbolIcon.typeParameterForeground": "{{normal}}",
        "symbolIcon.unitForeground": "{{normal}}",
        "symbolIcon.variableForeground": "{{normal}}",
        "terminalSymbolIcon.aliasForeground": "{{normal}}",
        "terminalSymbolIcon.argumentForeground": "{{normal}}",
        "terminalSymbolIcon.branchForeground": "{{normal}}",
        "terminalSymbolIcon.commitForeground": "{{normal}}",
        "terminalSymbolIcon.fileForeground": "{{normal}}",
        "terminalSymbolIcon.flagForeground": "{{normal}}",
        "terminalSymbolIcon.folderForeground": "{{normal}}",
        "terminalSymbolIcon.inlineSuggestionForeground": "{{normal}}",
        "terminalSymbolIcon.methodForeground": "{{normal}}",
        "terminalSymbolIcon.optionForeground": "{{normal}}",
        "terminalSymbolIcon.optionValueForeground": "{{normal}}",
        "terminalSymbolIcon.pullRequestDoneForeground": "{{normal}}",
        "terminalSymbolIcon.pullRequestForeground": "{{normal}}",
        "terminalSymbolIcon.remoteForeground": "{{normal}}",
        "terminalSymbolIcon.stashForeground": "{{normal}}",
        "terminalSymbolIcon.symbolText": "{{normal}}",
        "terminalSymbolIcon.symbolicLinkFileForeground": "{{normal}}",
        "terminalSymbolIcon.symbolicLinkFolderForeground": "{{normal}}",
        "terminalSymbolIcon.tagForeground": "{{normal}}",

        // Source control graph
        "scmGraph.foreground1": "{{bright}}", // lanes alternate like nvim's rainbow-delimiters
        "scmGraph.foreground2": "{{fg}}",
        "scmGraph.foreground3": "{{bright}}",
        "scmGraph.foreground4": "{{fg}}",
        "scmGraph.foreground5": "{{bright}}",
        "scmGraph.historyItemRefColor": "{{bright}}",
        "scmGraph.historyItemRemoteRefColor": "{{selection}}",
        "scmGraph.historyItemBaseRefColor": "{{link}}",
        "scmGraph.historyItemHoverAdditionsForeground": "{{added}}",
        "scmGraph.historyItemHoverDeletionsForeground": "{{removed}}",

        // VS Code's own hues, mapped by meaning onto the theme's roles: red is removed, yellow and
        // orange are warning, green is added, blue becomes link, purple becomes selection
        "charts.foreground": "{{fg}}",
        "charts.lines": "{{dim}}",
        "charts.red": "{{removed}}",
        "charts.yellow": "{{warning}}",
        "charts.orange": "{{warning}}",
        "charts.green": "{{added}}",
        "charts.blue": "{{link}}",
        "charts.purple": "{{selection}}",
        "chart.line": "{{bright}}",
        "markdownAlert.note.foreground": "{{link}}",
        "markdownAlert.tip.foreground": "{{bright}}",
        "markdownAlert.important.foreground": "{{selection}}",
        "markdownAlert.warning.foreground": "{{warning}}",
        "markdownAlert.caution.foreground": "{{error}}",
        "activityErrorBadge.background": "{{error}}",
        "activityErrorBadge.foreground": "{{bg}}",
        "activityWarningBadge.background": "{{warning}}",
        "activityWarningBadge.foreground": "{{bg}}",
        "statusBarItem.offlineBackground": "{{error}}",
        "statusBarItem.offlineForeground": "{{bg}}",
        "list.invalidItemForeground": "{{warning}}",
        "listFilterWidget.noMatchesOutline": "{{error}}",
        "tab.activeModifiedBorder": "{{white}}",
        "tab.inactiveModifiedBorder": "{{white}}80",
        "tab.unfocusedActiveModifiedBorder": "{{white}}80",
        "tab.unfocusedInactiveModifiedBorder": "{{white}}80",
        "editor.linkedEditingBackground": "{{selection}}1a",
        "editorOverviewRuler.findMatchForeground": "{{bright}}",
        "terminalOverviewRuler.findMatchForeground": "{{bright}}",
        "diffEditor.move.border": "{{dim}}",
        "diffEditor.moveActive.border": "{{warning}}",
        "extensionIcon.starForeground": "{{bright}}",
        "extensionIcon.preReleaseForeground": "{{bright}}",
        "extensionIcon.sponsorForeground": "{{bright}}",
        "mcpIcon.starForeground": "{{bright}}",
        "testing.iconPassed": "{{bright}}",
        "testing.iconPassed.retired": "{{bright}}b3",
        "testing.runAction": "{{bright}}",
        "testing.message.error.badgeBackground": "{{error}}",
        "testing.message.error.badgeBorder": "{{error}}",
        "testing.message.error.badgeForeground": "{{bg}}",
        "notebookStatusSuccessIcon.foreground": "{{bright}}",
        "notebookEditorOverviewRuler.runningCellForeground": "{{bright}}",

        // Debugging
        "debugIcon.breakpointForeground": "{{error}}",
        "debugIcon.breakpointDisabledForeground": "{{dim}}",
        "debugIcon.breakpointUnverifiedForeground": "{{dim}}",
        "debugIcon.breakpointCurrentStackframeForeground": "{{warning}}",
        "debugIcon.breakpointStackframeForeground": "{{bright}}",
        "debugIcon.startForeground": "{{bright}}",
        "debugIcon.continueForeground": "{{bright}}",
        "debugIcon.pauseForeground": "{{bright}}",
        "debugIcon.stepOverForeground": "{{bright}}",
        "debugIcon.stepIntoForeground": "{{bright}}",
        "debugIcon.stepOutForeground": "{{bright}}",
        "debugIcon.stepBackForeground": "{{bright}}",
        "debugIcon.restartForeground": "{{bright}}",
        "debugIcon.stopForeground": "{{error}}",
        "debugIcon.disconnectForeground": "{{error}}",
        "debugTokenExpression.name": "{{fg}}",
        "debugTokenExpression.value": "{{fg}}",
        "debugTokenExpression.string": "{{normal}}",
        "debugTokenExpression.number": "{{normal}}",
        "debugTokenExpression.boolean": "{{normal}}",
        "debugTokenExpression.type": "{{bright}}",
        "debugTokenExpression.error": "{{error}}",
        "debugView.exceptionLabelBackground": "{{error}}",
        "debugView.exceptionLabelForeground": "{{bg}}",
        "debugView.valueChangedHighlight": "{{bright}}",
        "debugExceptionWidget.background": "{{dark}}",
        "debugExceptionWidget.border": "{{error}}",
        "editor.stackFrameHighlightBackground": "{{warning}}33",
        "editor.focusedStackFrameHighlightBackground": "{{bright}}33",
        "editor.inlineValuesBackground": "{{selection}}1a",
        "editor.inlineValuesForeground": "{{dim}}",

        // Merge editor: the same colors as the diff editor
        "mergeEditor.change.background": "{{diff_add}}",
        "mergeEditor.change.word.background": "{{diff_add_word}}",
        "mergeEditor.changeBase.background": "{{diff_del}}",
        "mergeEditor.changeBase.word.background": "{{diff_del_word}}",
        "mergeEditor.conflict.unhandledFocused.border": "{{warning}}",
        "mergeEditor.conflict.unhandledUnfocused.border": "{{warning}}7a",
        "mergeEditor.conflict.unhandled.minimapOverViewRuler": "{{warning}}",
        "mergeEditor.conflictingLines.background": "{{warning}}26",

        // Chat
        "chat.slashCommandBackground": "{{dark}}",
        "chat.slashCommandForeground": "{{selection}}",
        "chat.requestCodeBorder": "{{fg}}26",
        "chat.editedFileForeground": "{{white}}",
        "chat.linesAddedForeground": "{{added}}",
        "chat.linesRemovedForeground": "{{removed}}",
        "chat.mcpCompatibilityWarningForeground": "{{warning}}",
        "chat.workingProgressStableIconForeground": "{{bright}}",
        "chat.workingProgressInsidersIconForeground": "{{bright}}",
        "chat.sessionStateIndicator.unvisitedBorder": "{{bright}}",
        "agentsVoice.speakingForeground": "{{bright}}",

        // GitHub Pull Requests extension: GitHub's purple (merged, closed issues) becomes mint
        "pullRequests.open": "{{bright}}",
        "pullRequests.merged": "{{selection}}",
        "pullRequests.closed": "{{removed}}",
        "issues.open": "{{bright}}",
        "issues.closed": "{{selection}}",
        "github.issues.closed": "{{selection}}",

        // Floats: nvim's NormalFloat, FloatBorder, Pmenu and PmenuSel
        "editorWidget.background": "{{dark}}",
        "editorWidget.foreground": "{{fg}}",
        "editorWidget.border": "{{fg}}26",
        "editorWidget.resizeBorder": "{{fg}}26",
        "editorHoverWidget.background": "{{dark}}",
        "editorHoverWidget.foreground": "{{fg}}",
        "editorHoverWidget.border": "{{fg}}26",
        "editorHoverWidget.highlightForeground": "{{bright}}",
        "editorHoverWidget.statusBarBackground": "{{dark}}",
        "editorSuggestWidget.background": "{{dark}}",
        "editorSuggestWidget.foreground": "{{fg}}",
        "editorSuggestWidget.border": "{{fg}}26",
        "editorSuggestWidget.selectedBackground": "{{fg}}",
        "editorSuggestWidget.selectedForeground": "{{bg}}",
        "editorSuggestWidget.selectedIconForeground": "{{bg}}",
        "editorSuggestWidget.highlightForeground": "{{bright}}",
        "editorSuggestWidget.focusHighlightForeground": "{{bg}}",
        "editorSuggestWidgetStatus.foreground": "{{dim}}",
        "quickInput.background": "{{dark}}",
        "quickInput.foreground": "{{fg}}",
        "quickInputTitle.background": "{{dark}}",
        "quickInputList.focusBackground": "{{fg}}",
        "quickInputList.focusForeground": "{{bg}}",
        "quickInputList.focusIconForeground": "{{bg}}",
        "pickerGroup.foreground": "{{bright}}",
        "pickerGroup.border": "{{fg}}26",
        "menu.background": "{{dark}}",
        "menu.foreground": "{{fg}}",
        "menu.border": "{{fg}}26",
        "menu.selectionBackground": "{{fg}}",
        "menu.selectionForeground": "{{bg}}",
        "menu.separatorBackground": "{{fg}}26",
        "menubar.selectionBackground": "{{cursor_line}}",
        "menubar.selectionForeground": "{{bright}}",
        "peekView.border": "{{fg}}26",
        "peekViewTitle.background": "{{dark}}",
        "peekViewTitleLabel.foreground": "{{bright}}",
        "peekViewTitleDescription.foreground": "{{dim}}",
        "peekViewEditor.background": "{{dark}}",
        "peekViewEditorGutter.background": "{{dark}}",
        "peekViewEditor.matchHighlightBackground": "{{fg}}66",
        "peekViewResult.background": "{{dark}}",
        "peekViewResult.fileForeground": "{{bright}}",
        "peekViewResult.lineForeground": "{{fg}}",
        "peekViewResult.selectionBackground": "{{fg}}",
        "peekViewResult.selectionForeground": "{{bg}}",
        "peekViewResult.matchHighlightBackground": "{{fg}}66",
        "debugToolBar.background": "{{dark}}",
        "debugToolBar.border": "{{fg}}26",
        "input.background": "{{dark}}",
        "input.foreground": "{{fg}}",
        "input.border": "{{fg}}26",
        "input.placeholderForeground": "{{dim}}",
        "inputOption.activeBackground": "{{cursor_line}}",
        "inputOption.activeForeground": "{{bright}}",
        "inputOption.activeBorder": "{{bright}}",
        "inputValidation.errorBackground": "{{dark}}",
        "inputValidation.errorBorder": "{{error}}",
        "inputValidation.warningBackground": "{{dark}}",
        "inputValidation.warningBorder": "{{warning}}",
        "inputValidation.infoBackground": "{{dark}}",
        "inputValidation.infoBorder": "{{bright}}",
        "dropdown.background": "{{dark}}",
        "dropdown.listBackground": "{{dark}}",
        "dropdown.foreground": "{{fg}}",
        "dropdown.border": "{{fg}}26",
        "checkbox.background": "{{dark}}",
        "checkbox.foreground": "{{bright}}",
        "checkbox.border": "{{fg}}26",
        "button.background": "{{bright}}",
        "button.foreground": "{{bg}}",
        "button.hoverBackground": "{{normal}}",
        "button.secondaryBackground": "{{dark}}",
        "button.secondaryForeground": "{{fg}}",
        "button.secondaryHoverBackground": "{{cursor_line}}",
        "keybindingLabel.background": "{{dark}}",
        "keybindingLabel.foreground": "{{fg}}",
        "keybindingLabel.border": "{{fg}}26",
        "keybindingLabel.bottomBorder": "{{fg}}26",

        // Terminal: ghostty's palette, including its overrides of slots 8 and 12
        "terminal.background": "{{bg}}",
        "terminal.foreground": "{{fg}}",
        "terminal.border": "{{fg}}26",
        "terminalCursor.foreground": "{{normal}}",
        "terminalCursor.background": "{{cursor_text}}",
        "terminal.selectionBackground": "{{selection_tint}}", // selection_tint, like ghostty; no selectionForeground, so text keeps its colors
        "terminal.findMatchBackground": "{{bright}}66",
        "terminal.findMatchHighlightBackground": "{{fg}}4d",
        "terminalCommandDecoration.defaultBackground": "{{dim}}",
        "terminalCommandDecoration.successBackground": "{{bright}}",
        "terminalCommandDecoration.errorBackground": "{{error}}",
        "terminal.ansiBlack": "{{ansi0}}",
        "terminal.ansiRed": "{{ansi1}}",
        "terminal.ansiGreen": "{{ansi2}}",
        "terminal.ansiYellow": "{{ansi3}}",
        "terminal.ansiBlue": "{{ansi4}}",
        "terminal.ansiMagenta": "{{ansi5}}",
        "terminal.ansiCyan": "{{ansi6}}",
        "terminal.ansiWhite": "{{ansi7}}", // not Gr33N's white: ghostty uses fg so Claude Code's plain code text matches nvim's variables
        "terminal.ansiBrightBlack": "{{ansi8}}", // not Gr33N's #001510: ghostty uses dim_green so comments stay readable
        "terminal.ansiBrightRed": "{{ansi9}}",
        "terminal.ansiBrightGreen": "{{ansi10}}",
        "terminal.ansiBrightYellow": "{{ansi11}}",
        "terminal.ansiBrightBlue": "{{ansi12}}", // not bright_green: ghostty uses mint so Claude Code's inline code stands out
        "terminal.ansiBrightMagenta": "{{ansi13}}",
        "terminal.ansiBrightCyan": "{{ansi14}}",
        "terminal.ansiBrightWhite": "{{ansi15}}"
    },
    // Code: the colors nvim resolves for each treesitter capture with hax0r loaded
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "{{comment}}", "fontStyle": "italic" }
        },
        {
            "name": "String, Character",
            "scope": ["string", "punctuation.definition.string", "constant.character"],
            "settings": { "foreground": "{{normal}}" }
        },
        {
            "name": "Constant, Number, Boolean",
            "scope": ["constant", "constant.numeric", "constant.language.boolean", "variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "{{normal}}" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function", "meta.function-call.generic"],
            "settings": { "foreground": "{{normal}}" }
        },
        {
            "name": "Keyword (Statement)",
            "scope": ["keyword", "keyword.control", "keyword.other", "storage", "storage.type", "storage.modifier", "entity.name.label", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.word", "keyword.operator.logical.python"],
            "settings": { "foreground": "{{bold}}", "fontStyle": "bold" }
        },
        {
            "name": "Operator, Delimiter",
            "scope": ["keyword.operator", "punctuation", "storage.type.function.arrow"],
            "settings": { "foreground": "{{fg}}", "fontStyle": "" }
        },
        {
            "name": "Variable, Property",
            "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name", "meta.embedded", "meta.template.expression"],
            "settings": { "foreground": "{{fg}}" }
        },
        {
            "name": "Type, Module",
            "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace", "entity.name.type.module", "storage.type.primitive", "storage.type.built-in"],
            "settings": { "foreground": "{{bright}}", "fontStyle": "" }
        },
        {
            "name": "Special: builtins, escapes, regex, tags, attributes",
            "scope": ["support.function", "support.constant", "support.variable", "constant.language", "variable.language", "constant.character.escape", "string.regexp", "constant.other.placeholder", "constant.character.entity", "punctuation.definition.template-expression", "punctuation.section.embedded", "entity.name.tag", "punctuation.definition.tag", "entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
            "settings": { "foreground": "{{bright}}", "fontStyle": "" }
        },
        {
            "name": "Markup: headings",
            "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
            "settings": { "foreground": "{{bold}}", "fontStyle": "bold" }
        },
        {
            "name": "Markup: raw, quote, list markers",
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw", "markup.quote", "punctuation.definition.list"],
            "settings": { "foreground": "{{bright}}" }
        },
        {
            "name": "Markup: links",
            "scope": ["markup.underline.link", "string.other.link", "markup.link"],
            "settings": { "foreground": "{{link}}", "fontStyle": "underline" }
        },
        {
            "name": "Markup: emphasis",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Diff",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "{{added}}" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "{{removed}}" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "{{white}}" }
        },
        {
            "name": "Error",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "{{error}}" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "fontStyle": "strikethrough" }
        }
    ],
    // Language-server tokens, matched to nvim's @lsp.* groups
    "semanticTokenColors": {
        "namespace": "{{bright}}",
        "type": "{{bright}}",
        "class": "{{bright}}",
        "enum": "{{bright}}",
        "interface": "{{bright}}",
        "struct": "{{bright}}",
        "typeParameter": "{{bright}}",
        "decorator": "{{bright}}",
        "enumMember": "{{normal}}",
        "function": "{{normal}}",
        "function.defaultLibrary": "{{normal}}",
        "method": "{{normal}}",
        "macro": "{{normal}}",
        "string": "{{normal}}",
        "number": "{{normal}}",
        "regexp": "{{bright}}",
        "keyword": { "foreground": "{{bold}}", "bold": true },
        "comment": { "foreground": "{{comment}}", "italic": true },
        "operator": "{{fg}}",
        "parameter": "{{fg}}",
        "variable": "{{fg}}",
        "variable.readonly": "{{fg}}",
        "variable.defaultLibrary": "{{fg}}",
        "property": "{{fg}}",
        "*.deprecated": { "strikethrough": true }
    }
}
