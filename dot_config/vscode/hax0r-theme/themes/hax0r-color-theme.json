// Mirrors ~/.config/nvim/colors/hax0r.lua. Palette, as named there:
//   bg #020f01, fg #16b10e, dark_green #001f0b (ansi 0), green #15d00d (ansi 1-6),
//   bright_green #19e20e (ansi 9-14), bold #19e30f, white #fafafa, bright_white #fefefe,
//   cursor #15d00d, cursor_text #ffffff, selection #d4ffc1, link #00e8ca,
//   selection_tint #1b2c18 (selection @ 12% over bg, added),
//   dim_green #0b8700 (badge #14ff00 @ 50% over bg), cursor_line #2e4640 (cursor guide @ 25%),
//   ghostty_black #334843, red #ff1111 (HaX0R R3D), dim_red #b00d0d (R3D), amber #ffb000 (added),
//   diff_green #003300, diff_green_word #004c00, diff_red #5f0000, diff_red_word #870000 (added).
// A color with a 2-digit alpha suffix is a palette color made see-through, for overlays
// that must not hide the text under them.
// Chrome borders are #16b10e26, fg at 15%: the faint outline VS Code itself draws around its
// panels. Not nvim's dim_green WinSeparator/FloatBorder, which looked loud next to those outlines.
{
    "$schema": "vscode://schemas/color-theme",
    "name": "hax0r",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        // Chrome
        "foreground": "#16b10e",
        "descriptionForeground": "#0b8700",
        "disabledForeground": "#0b8700",
        "errorForeground": "#ff1111",
        "icon.foreground": "#16b10e",
        "focusBorder": "#0b8700",
        "selection.background": "#d4ffc11f",
        "widget.shadow": "#00151033",
        "scrollbar.shadow": "#00151033",
        "sash.hoverBorder": "#0b8700",
        "titleBar.activeBackground": "#020f01",
        "titleBar.activeForeground": "#16b10e",
        "titleBar.inactiveBackground": "#020f01",
        "titleBar.inactiveForeground": "#0b8700",
        "activityBar.background": "#020f01",
        "activityBar.foreground": "#19e20e",
        "activityBar.inactiveForeground": "#0b8700",
        "activityBar.activeBorder": "#19e20e",
        "activityBar.border": "#16b10e26",
        "activityBarBadge.background": "#14ff0080",
        "activityBarBadge.foreground": "#020f01",
        "badge.background": "#14ff0080",
        "badge.foreground": "#020f01",
        "sideBar.background": "#020f01",
        "sideBar.foreground": "#16b10e",
        "sideBar.border": "#16b10e26",
        "sideBarTitle.foreground": "#19e20e",
        "sideBarSectionHeader.background": "#001f0b",
        "sideBarSectionHeader.foreground": "#19e20e",
        "editorGroup.border": "#16b10e26", // see "Chrome borders" at the top
        "editorGroupHeader.tabsBackground": "#001f0b",
        "tab.activeBackground": "#020f01",
        "tab.activeForeground": "#19e20e", // not fg like nvim's bold TabLineSel: tabs can't be bold
        "tab.inactiveBackground": "#001f0b",
        "tab.inactiveForeground": "#0b8700",
        "tab.unfocusedActiveForeground": "#16b10e",
        "tab.unfocusedInactiveForeground": "#0b8700",
        "tab.border": "#001f0b",
        "tab.lastPinnedBorder": "#16b10e26",
        "statusBar.background": "#001f0b",
        "statusBar.foreground": "#19e20e",
        "statusBar.noFolderBackground": "#001f0b",
        "statusBar.debuggingBackground": "#16b10e",
        "statusBar.debuggingForeground": "#020f01",
        "statusBarItem.remoteBackground": "#001f0b",
        "statusBarItem.remoteForeground": "#19e20e",
        "statusBarItem.hoverBackground": "#2e4640",
        "statusBarItem.activeBackground": "#0b8700",
