        "terminalSymbolIcon.methodForeground": "#15d00d",
        "terminalSymbolIcon.optionForeground": "#15d00d",
        "terminalSymbolIcon.optionValueForeground": "#15d00d",
        "terminalSymbolIcon.pullRequestDoneForeground": "#15d00d",
