        "keybindingLabel.bottomBorder": "#16b10e26",

        // Terminal: ghostty's palette, including its overrides of slots 8 and 12
        "terminal.background": "#020f01",
        "terminal.foreground": "#16b10e",
        "terminal.border": "#16b10e26",
        "terminalCursor.foreground": "#15d00d",
        "terminalCursor.background": "#ffffff",
        "terminal.selectionBackground": "#1b2c18", // selection_tint, like ghostty; no selectionForeground, so text keeps its colors
        "terminal.findMatchBackground": "#19e20e66",
        "terminal.findMatchHighlightBackground": "#16b10e4d",
        "terminalCommandDecoration.defaultBackground": "#0b8700",
        "terminalCommandDecoration.successBackground": "#19e20e",
        "terminalCommandDecoration.errorBackground": "#ff1111",
        "terminal.ansiBlack": "#001f0b",
        "terminal.ansiRed": "#15d00d",
        "terminal.ansiGreen": "#15d00d",
        "terminal.ansiYellow": "#15d00d",
        "terminal.ansiBlue": "#15d00d",
        "terminal.ansiMagenta": "#15d00d",
        "terminal.ansiCyan": "#15d00d",
        "terminal.ansiWhite": "#16b10e", // not Gr33N's white: ghostty uses fg so Claude Code's plain code text matches nvim's variables
        "terminal.ansiBrightBlack": "#0b8700", // not Gr33N's #001510: ghostty uses dim_green so comments stay readable
        "terminal.ansiBrightRed": "#19e20e",
        "terminal.ansiBrightGreen": "#19e20e",
        "terminal.ansiBrightYellow": "#19e20e",
        "terminal.ansiBrightBlue": "#d4ffc1", // not bright_green: ghostty uses mint so Claude Code's inline code stands out
        "terminal.ansiBrightMagenta": "#19e20e",
        "terminal.ansiBrightCyan": "#19e20e",
        "terminal.ansiBrightWhite": "#fefefe"
    },
    // Code: the colors nvim resolves for each treesitter capture with hax0r loaded
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#0b8700", "fontStyle": "italic" }
        },
        {
            "name": "String, Character",
            "scope": ["string", "punctuation.definition.string", "constant.character"],
            "settings": { "foreground": "#15d00d" }
        },
        {
            "name": "Constant, Number, Boolean",
            "scope": ["constant", "constant.numeric", "constant.language.boolean", "variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#15d00d" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function", "meta.function-call.generic"],
            "settings": { "foreground": "#15d00d" }
        },
        {
            "name": "Keyword (Statement)",
            "scope": ["keyword", "keyword.control", "keyword.other", "storage", "storage.type", "storage.modifier", "entity.name.label", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.word", "keyword.operator.logical.python"],
            "settings": { "foreground": "#19e30f", "fontStyle": "bold" }
        },
        {
            "name": "Operator, Delimiter",
            "scope": ["keyword.operator", "punctuation", "storage.type.function.arrow"],
            "settings": { "foreground": "#16b10e", "fontStyle": "" }
        },
        {
            "name": "Variable, Property",
            "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name", "meta.embedded", "meta.template.expression"],
            "settings": { "foreground": "#16b10e" }
        },
        {
            "name": "Type, Module",
            "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace", "entity.name.type.module", "storage.type.primitive", "storage.type.built-in"],
            "settings": { "foreground": "#19e20e", "fontStyle": "" }
        },
        {
            "name": "Special: builtins, escapes, regex, tags, attributes",
            "scope": ["support.function", "support.constant", "support.variable", "constant.language", "variable.language", "constant.character.escape", "string.regexp", "constant.other.placeholder", "constant.character.entity", "punctuation.definition.template-expression", "punctuation.section.embedded", "entity.name.tag", "punctuation.definition.tag", "entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
            "settings": { "foreground": "#19e20e", "fontStyle": "" }
        },
        {
            "name": "Markup: headings",
            "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
            "settings": { "foreground": "#19e30f", "fontStyle": "bold" }
        },
        {
            "name": "Markup: raw, quote, list markers",
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw", "markup.quote", "punctuation.definition.list"],
            "settings": { "foreground": "#19e20e" }
        },
        {
            "name": "Markup: links",
            "scope": ["markup.underline.link", "string.other.link", "markup.link"],
            "settings": { "foreground": "#00e8ca", "fontStyle": "underline" }
        },
        {
            "name": "Markup: emphasis",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Diff",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#19e20e" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff1111" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "name": "Error",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff1111" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "fontStyle": "strikethrough" }
        }
    ],
    // Language-server tokens, matched to nvim's @lsp.* groups
    "semanticTokenColors": {
        "namespace": "#19e20e",
        "type": "#19e20e",
        "class": "#19e20e",
        "enum": "#19e20e",
        "interface": "#19e20e",
        "struct": "#19e20e",
        "typeParameter": "#19e20e",
        "decorator": "#19e20e",
        "enumMember": "#15d00d",
        "function": "#15d00d",
        "function.defaultLibrary": "#15d00d",
        "method": "#15d00d",
        "macro": "#15d00d",
        "string": "#15d00d",
        "number": "#15d00d",
        "regexp": "#19e20e",
        "keyword": { "foreground": "#19e30f", "bold": true },
        "comment": { "foreground": "#0b8700", "italic": true },
        "operator": "#16b10e",
        "parameter": "#16b10e",
        "variable": "#16b10e",
        "variable.readonly": "#16b10e",
        "variable.defaultLibrary": "#16b10e",
        "property": "#16b10e",
        "*.deprecated": { "strikethrough": true }
    }
}
