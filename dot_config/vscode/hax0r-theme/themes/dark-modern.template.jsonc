// Dark Modern for VS Code, as a hax0r template: VS Code 1.144's Dark Modern, with the Dark+ and Dark
// (Visual Studio) themes it builds on, in one file. Each color with a job in palettes.lua is that
// job here, so `hax0r build` gives back Dark Modern exactly until a color there changes. The colors
// left as hex are Dark Modern's one-offs (a button's hover shade, an input's border): to tweak one,
// give it a name in palettes.lua and use the name here. Built once by a script from VS Code's files.
{
    "name": "{{label}}",
    "type": "{{type}}",
    "semanticHighlighting": true,
    "colors": {
        // Dark Modern's own
        "activityBar.activeBorder": "{{focus}}",
        "activityBar.background": "{{dark}}",
        "activityBar.border": "{{border}}",
        "activityBar.foreground": "#D7D7D7",
        "activityBar.inactiveForeground": "#868686",
        "activityBarBadge.background": "{{focus}}",
        "activityBarBadge.foreground": "#FFFFFF",
        "badge.background": "{{badge}}",
        "badge.foreground": "#F8F8F8",
        "button.background": "{{focus}}",
        "button.border": "#ffffff1a",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#026EC1",
        "button.secondaryBackground": "#00000000",
        "button.secondaryForeground": "{{fg}}",
        "button.secondaryHoverBackground": "{{border}}",
        "chat.slashCommandBackground": "#26477866",
        "chat.slashCommandForeground": "#85B6FF",
        "chat.editedFileForeground": "{{changed}}",
        "checkbox.background": "#313131",
        "checkbox.border": "#3C3C3C",
        "debugToolBar.background": "{{dark}}",
        "descriptionForeground": "{{dim}}",
        "dropdown.background": "#313131",
        "dropdown.border": "#3C3C3C",
        "dropdown.foreground": "{{fg}}",
        "dropdown.listBackground": "{{bg}}",
        "editor.background": "{{bg}}",
        "editor.findMatchBackground": "{{cur_search}}",
        "editor.foreground": "{{fg}}",
        "editorGroup.border": "#FFFFFF17",
        "editorGroupHeader.tabsBackground": "{{dark}}",
        "editorGroupHeader.connectedTabsBackground": "{{border}}",
        "editorGroupHeader.tabsBorder": "{{border}}",
        "editorGutter.addedBackground": "{{mark_added}}",
        "editorGutter.deletedBackground": "{{mark_removed}}",
        "editorGutter.modifiedBackground": "{{mark_changed}}",
        "editorLineNumber.activeForeground": "{{line_nr_active}}",
        "editorLineNumber.foreground": "{{line_nr}}",
        "editorOverviewRuler.border": "#010409",
        "editorWidget.background": "{{float_bg}}",
        "errorForeground": "#F85149",
        "focusBorder": "{{focus}}",
        "foreground": "{{fg}}",
        "icon.foreground": "{{fg}}",
        "input.background": "#313131",
        "input.border": "#3C3C3C",
        "input.foreground": "{{fg}}",
        "input.placeholderForeground": "#989898",
        "inputOption.activeBackground": "#2489DB82",
        "inputOption.activeBorder": "#2488DB",
        "keybindingLabel.foreground": "{{fg}}",
        "menu.background": "{{bg}}",
        "menu.selectionBackground": "{{focus}}",
        "notificationCenterHeader.background": "{{bg}}",
        "notificationCenterHeader.foreground": "{{fg}}",
        "notifications.background": "{{bg}}",
        "notifications.border": "{{border}}",
        "notifications.foreground": "{{fg}}",
        "panel.background": "{{dark}}",
        "panel.border": "{{border}}",
        "panelInput.border": "{{border}}",
        "panelTitle.activeBorder": "{{focus}}",
        "panelTitle.activeForeground": "{{fg}}",
        "panelTitle.inactiveForeground": "{{dim}}",
        "peekViewEditor.background": "{{bg}}",
        "peekViewEditor.matchHighlightBackground": "#BB800966",
        "peekViewResult.background": "{{bg}}",
        "peekViewResult.matchHighlightBackground": "#BB800966",
        "pickerGroup.border": "#3C3C3C",
        "progressBar.background": "{{focus}}",
        "quickInput.background": "#222222",
        "quickInput.foreground": "{{fg}}",
        "settings.dropdownBackground": "#313131",
        "settings.dropdownBorder": "#3C3C3C",
        "settings.headerForeground": "{{bright}}",
        "settings.modifiedItemIndicator": "#BB800966",
        "sideBar.background": "{{dark}}",
        "sideBar.border": "{{border}}",
        "sideBar.foreground": "{{fg}}",
        "sideBarSectionHeader.background": "{{dark}}",
        "sideBarSectionHeader.border": "{{border}}",
        "sideBarSectionHeader.foreground": "{{fg}}",
        "sideBarTitle.foreground": "{{fg}}",
        "statusBar.background": "{{dark}}",
        "statusBar.inactiveBackground": "{{bg}}",
        "statusBar.border": "{{border}}",
        "statusBarItem.hoverBackground": "#F1F1F133",
        "statusBarItem.hoverForeground": "{{bright}}",
        "statusBar.debuggingBackground": "{{focus}}",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBar.focusBorder": "{{focus}}",
        "statusBar.foreground": "{{fg}}",
        "statusBar.noFolderBackground": "{{bg}}",
        "statusBarItem.focusBorder": "{{focus}}",
        "statusBarItem.prominentBackground": "#6E768166",
        "statusBarItem.remoteBackground": "{{focus}}",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "tab.activeBackground": "{{bg}}",
        "tab.activeBorder": "{{bg}}",
        "tab.activeBorderTop": "{{focus}}",
        "tab.activeForeground": "{{bright}}",
        "tab.selectedBorderTop": "#6caddf",
        "tab.border": "{{border}}",
        "tab.hoverBackground": "{{bg}}",
        "tab.inactiveBackground": "{{dark}}",
        "tab.inactiveForeground": "{{dim}}",
        "tab.unfocusedActiveBorder": "{{bg}}",
        "tab.unfocusedActiveBorderTop": "{{border}}",
        "tab.unfocusedHoverBackground": "{{bg}}",
        "terminal.foreground": "{{fg}}",
        "terminal.tab.activeBorder": "{{focus}}",
        "textBlockQuote.background": "{{border}}",
        "textBlockQuote.border": "#616161",
        "textCodeBlock.background": "{{border}}",
        "textLink.activeForeground": "{{link}}",
        "textLink.foreground": "{{link}}",
        "textPreformat.foreground": "#D0D0D0",
        "textPreformat.background": "#3C3C3C",
        "textSeparator.foreground": "#21262D",
        "titleBar.activeBackground": "{{dark}}",
        "titleBar.activeForeground": "{{fg}}",
        "titleBar.border": "{{border}}",
        "titleBar.inactiveBackground": "{{bg}}",
        "titleBar.inactiveForeground": "{{dim}}",
        "welcomePage.tileBackground": "{{border}}",
        "welcomePage.progress.foreground": "{{focus}}",
        "widget.border": "#313131",
        "modernActivityBarItem.activeBackground": "#FFFFFF22",
        "modernActivityBarItem.hoverBackground": "#FFFFFF11",
        "modernActivityBar.border": "#252526",

        // From Dark (Visual Studio), where Dark Modern doesn't set them
        "editor.inactiveSelectionBackground": "#3A3D41",
        "editorIndentGuide.background1": "{{indent}}",
        "editorIndentGuide.activeBackground1": "{{indent_active}}",
        "editor.selectionHighlightBackground": "#ADD6FF26",
        "list.dropBackground": "#383B3D",
        "browser.border": "#00000000",
        "menu.foreground": "{{fg}}",
        "menu.separatorBackground": "{{float_border}}",
        "menu.border": "{{float_border}}",
        "ports.iconRunningProcessForeground": "#369432",
        "tab.selectedBackground": "#37373D",
        "tab.selectedForeground": "{{bright}}",
        "tab.lastPinnedBorder": "#ccc3",
        "list.activeSelectionIconForeground": "#FFF",
        "terminal.inactiveSelectionBackground": "#3A3D41",
        "actionBar.toggledBackground": "#383a49",
        "agentsPanel.border": "#303031",
        "agentsChatInput.border": "#303031",
        "agentsChatInput.focusBorder": "#007ACC",
        "agentsNewSessionButton.border": "#303031",
        "surface.border": "#252526",

        // VS Code's own defaults, written out so they follow palettes.lua
        "editor.selectionBackground": "{{selection_tint}}",
        "editor.lineHighlightBorder": "{{cursor_line}}",
        "editorCursor.foreground": "{{cursor}}",
        "editor.findMatchHighlightBackground": "{{search_tint}}55",
        "editorWhitespace.foreground": "{{nontext_tint}}29",
        "list.activeSelectionBackground": "{{selected_row}}",
        "list.hoverBackground": "{{hover}}",
        "list.inactiveSelectionBackground": "{{unfocused_row}}",
        "list.highlightForeground": "{{match}}",
        "editorError.foreground": "{{error}}",
        "editorWarning.foreground": "{{warning}}",
        "editorInfo.foreground": "{{info}}",
        "editorBracketHighlight.foreground1": "{{brackets.1}}",
        "editorBracketHighlight.foreground2": "{{brackets.2}}",
        "editorBracketHighlight.foreground3": "{{brackets.3}}",
        "diffEditor.insertedLineBackground": "{{diff_add_tint}}33",
        "diffEditor.insertedTextBackground": "{{diff_add_word_tint}}33",
        "diffEditor.removedLineBackground": "{{diff_del_tint}}33",
        "diffEditor.removedTextBackground": "{{diff_del_tint}}33",
        "gitDecoration.addedResourceForeground": "{{added}}",
        "gitDecoration.modifiedResourceForeground": "{{changed}}",
        "gitDecoration.deletedResourceForeground": "{{removed}}",
        "gitDecoration.renamedResourceForeground": "{{untracked}}",
        "gitDecoration.untrackedResourceForeground": "{{untracked}}",
        "gitDecoration.ignoredResourceForeground": "{{ignored}}",
        "gitDecoration.stageModifiedResourceForeground": "{{changed}}",
        "gitDecoration.stageDeletedResourceForeground": "{{removed}}",
        "gitDecoration.conflictingResourceForeground": "{{conflict}}",
        "charts.red": "{{hues.red}}",
        "charts.orange": "{{hues.orange}}",
        "charts.yellow": "{{hues.yellow}}",
        "charts.green": "{{hues.green}}",
        "charts.blue": "{{hues.blue}}",
        "charts.purple": "{{hues.purple}}",
        "terminal.ansiBlack": "{{ansi0}}",
        "terminal.ansiRed": "{{ansi1}}",
        "terminal.ansiGreen": "{{ansi2}}",
        "terminal.ansiYellow": "{{ansi3}}",
        "terminal.ansiBlue": "{{ansi4}}",
        "terminal.ansiMagenta": "{{ansi5}}",
        "terminal.ansiCyan": "{{ansi6}}",
        "terminal.ansiWhite": "{{ansi7}}",
        "terminal.ansiBrightBlack": "{{ansi8}}",
        "terminal.ansiBrightRed": "{{ansi9}}",
        "terminal.ansiBrightGreen": "{{ansi10}}",
        "terminal.ansiBrightYellow": "{{ansi11}}",
        "terminal.ansiBrightBlue": "{{ansi12}}",
        "terminal.ansiBrightMagenta": "{{ansi13}}",
        "terminal.ansiBrightCyan": "{{ansi14}}",
        "terminal.ansiBrightWhite": "{{ansi15}}"
    },
    "tokenColors": [
        {"scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown", "variable.legacy.builtin.python"], "settings": {"foreground": "{{syntax.plain}}"}},
        {"scope": "emphasis", "settings": {"fontStyle": "italic"}},
        {"scope": "strong", "settings": {"fontStyle": "bold"}},
        {"scope": "header", "settings": {"foreground": "#000080"}},
        {"scope": "comment", "settings": {"foreground": "{{syntax.comment}}"}},
        {"scope": "constant.language", "settings": {"foreground": "{{syntax.builtin}}"}},
        {"scope": ["constant.numeric", "variable.other.enummember", "keyword.operator.plus.exponent", "keyword.operator.minus.exponent"], "settings": {"foreground": "{{syntax.number}}"}},
        {"scope": "constant.regexp", "settings": {"foreground": "#646695"}},
        {"scope": "entity.name.tag", "settings": {"foreground": "{{syntax.tag}}"}},
        {"scope": ["entity.name.tag.css", "entity.name.tag.less"], "settings": {"foreground": "{{syntax.selector}}"}},
        {"scope": "entity.other.attribute-name", "settings": {"foreground": "{{syntax.attribute}}"}},
        {"scope": ["entity.other.attribute-name.class.css", "source.css entity.other.attribute-name.class", "entity.other.attribute-name.id.css", "entity.other.attribute-name.parent-selector.css", "entity.other.attribute-name.parent.less", "source.css entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element.css", "source.css.less entity.other.attribute-name.id", "entity.other.attribute-name.scss"], "settings": {"foreground": "{{syntax.selector}}"}},
        {"scope": "invalid", "settings": {"foreground": "#f44747"}},
        {"scope": "markup.underline", "settings": {"fontStyle": "underline"}},
        {"scope": "markup.bold", "settings": {"fontStyle": "bold", "foreground": "{{syntax.strong}}"}},
        {"scope": "markup.heading", "settings": {"fontStyle": "bold", "foreground": "{{syntax.heading}}"}},
        {"scope": "markup.italic", "settings": {"fontStyle": "italic", "foreground": "{{syntax.emphasis}}"}},
        {"scope": "markup.strikethrough", "settings": {"fontStyle": "strikethrough"}},
        {"scope": "markup.inserted", "settings": {"foreground": "{{syntax.inserted}}"}},
        {"scope": "markup.deleted", "settings": {"foreground": "{{syntax.deleted}}"}},
        {"scope": "markup.changed", "settings": {"foreground": "{{syntax.modified}}"}},
        {"scope": "punctuation.definition.quote.begin.markdown", "settings": {"foreground": "{{syntax.quote}}"}},
        {"scope": "punctuation.definition.list.begin.markdown", "settings": {"foreground": "{{syntax.list}}"}},
        {"scope": "markup.inline.raw", "settings": {"foreground": "{{syntax.raw}}"}},
        {"name": "brackets of XML/HTML tags", "scope": "punctuation.definition.tag", "settings": {"foreground": "{{syntax.tag_bracket}}"}},
        {"scope": ["meta.preprocessor", "entity.name.function.preprocessor"], "settings": {"foreground": "{{syntax.macro}}"}},
        {"scope": "meta.preprocessor.string", "settings": {"foreground": "{{syntax.string}}"}},
        {"scope": "meta.preprocessor.numeric", "settings": {"foreground": "{{syntax.number}}"}},
        {"scope": "meta.structure.dictionary.key.python", "settings": {"foreground": "{{syntax.variable}}"}},
        {"scope": "meta.diff.header", "settings": {"foreground": "{{syntax.modified}}"}},
        {"scope": "storage", "settings": {"foreground": "{{syntax.storage}}"}},
        {"scope": "storage.type", "settings": {"foreground": "{{syntax.storage}}"}},
        {"scope": ["storage.modifier", "keyword.operator.noexcept"], "settings": {"foreground": "{{syntax.storage}}"}},
        {"scope": ["string", "meta.embedded.assembly"], "settings": {"foreground": "{{syntax.string}}"}},
        {"scope": "string.tag", "settings": {"foreground": "{{syntax.string}}"}},
        {"scope": "string.value", "settings": {"foreground": "{{syntax.string}}"}},
        {"scope": "string.regexp", "settings": {"foreground": "{{syntax.regex}}"}},
        {"name": "String interpolation", "scope": ["punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end", "punctuation.section.embedded"], "settings": {"foreground": "{{syntax.keyword}}"}},
        {"name": "Reset JavaScript string interpolation expression", "scope": ["meta.template.expression"], "settings": {"foreground": "{{syntax.plain}}"}},
        {"scope": ["support.type.vendored.property-name", "support.type.property-name", "source.css variable", "source.coffee.embedded"], "settings": {"foreground": "{{syntax.variable}}"}},
        {"scope": "keyword", "settings": {"foreground": "{{syntax.keyword}}"}},
        {"scope": "keyword.control", "settings": {"foreground": "{{syntax.keyword}}"}},
        {"scope": "keyword.operator", "settings": {"foreground": "{{syntax.operator}}"}},
        {"scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.cast", "keyword.operator.sizeof", "keyword.operator.alignof", "keyword.operator.typeid", "keyword.operator.alignas", "keyword.operator.instanceof", "keyword.operator.logical.python", "keyword.operator.wordlike"], "settings": {"foreground": "{{syntax.keyword}}"}},
        {"scope": "keyword.other.unit", "settings": {"foreground": "{{syntax.number}}"}},
        {"scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"], "settings": {"foreground": "{{syntax.keyword}}"}},
        {"scope": "support.function.git-rebase", "settings": {"foreground": "{{syntax.variable}}"}},
        {"scope": "constant.sha.git-rebase", "settings": {"foreground": "{{syntax.number}}"}},
        {"name": "coloring of the Java import and package identifiers", "scope": ["storage.modifier.import.java", "variable.language.wildcard.java", "storage.modifier.package.java"], "settings": {"foreground": "{{syntax.plain}}"}},
        {"name": "this.self", "scope": "variable.language", "settings": {"foreground": "{{syntax.builtin}}"}},
        {"name": "Function declarations", "scope": ["entity.name.function", "support.function", "support.constant.handlebars", "source.powershell variable.other.member", "entity.name.operator.custom-literal"], "settings": {"foreground": "{{syntax.func}}"}},
        {"name": "Types declaration and references", "scope": ["support.class", "support.type", "entity.name.type", "entity.name.namespace", "entity.other.attribute", "entity.name.scope-resolution", "entity.name.class", "storage.type.numeric.go", "storage.type.byte.go", "storage.type.boolean.go", "storage.type.string.go", "storage.type.uintptr.go", "storage.type.error.go", "storage.type.rune.go", "storage.type.cs", "storage.type.generic.cs", "storage.type.modifier.cs", "storage.type.variable.cs", "storage.type.annotation.java", "storage.type.generic.java", "storage.type.java", "storage.type.object.array.java", "storage.type.primitive.array.java", "storage.type.primitive.java", "storage.type.token.java", "storage.type.groovy", "storage.type.annotation.groovy", "storage.type.parameters.groovy", "storage.type.generic.groovy", "storage.type.object.array.groovy", "storage.type.primitive.array.groovy", "storage.type.primitive.groovy"], "settings": {"foreground": "{{syntax.type}}"}},
        {"name": "Types declaration and references, TS grammar specific", "scope": ["meta.type.cast.expr", "meta.type.new.expr", "support.constant.math", "support.constant.dom", "support.constant.json", "entity.other.inherited-class", "punctuation.separator.namespace.ruby"], "settings": {"foreground": "{{syntax.type}}"}},
        {"name": "Control flow / Special keywords", "scope": ["keyword.control", "source.cpp keyword.operator.new", "keyword.operator.delete", "keyword.other.using", "keyword.other.directive.using", "keyword.other.operator", "entity.name.operator"], "settings": {"foreground": "{{syntax.control}}"}},
        {"name": "Variable and parameter name", "scope": ["variable", "meta.definition.variable.name", "support.variable", "entity.name.variable", "constant.other.placeholder"], "settings": {"foreground": "{{syntax.variable}}"}},
        {"name": "Constants and enums", "scope": ["variable.other.constant", "variable.other.enummember"], "settings": {"foreground": "{{syntax.constant}}"}},
        {"name": "Object keys, TS grammar specific", "scope": ["meta.object-literal.key"], "settings": {"foreground": "{{syntax.variable}}"}},
        {"name": "CSS property value", "scope": ["support.constant.property-value", "support.constant.font-name", "support.constant.media-type", "support.constant.media", "constant.other.color.rgb-value", "constant.other.rgb-value", "support.constant.color"], "settings": {"foreground": "{{syntax.string}}"}},
        {"name": "Regular expression groups", "scope": ["punctuation.definition.group.regexp", "punctuation.definition.group.assertion.regexp", "punctuation.definition.character-class.regexp", "punctuation.character.set.begin.regexp", "punctuation.character.set.end.regexp", "keyword.operator.negation.regexp", "support.other.parenthesis.regexp"], "settings": {"foreground": "{{syntax.string}}"}},
        {"scope": ["constant.character.character-class.regexp", "constant.other.character-class.set.regexp", "constant.other.character-class.regexp", "constant.character.set.regexp"], "settings": {"foreground": "{{syntax.regex}}"}},
        {"scope": ["keyword.operator.or.regexp", "keyword.control.anchor.regexp"], "settings": {"foreground": "{{syntax.func}}"}},
        {"scope": "keyword.operator.quantifier.regexp", "settings": {"foreground": "{{syntax.escape}}"}},
        {"scope": ["constant.character", "constant.other.option"], "settings": {"foreground": "{{syntax.builtin}}"}},
        {"scope": "constant.character.escape", "settings": {"foreground": "{{syntax.escape}}"}},
        {"scope": "entity.name.label", "settings": {"foreground": "{{syntax.label}}"}}
    ],
    "semanticTokenColors": {
        "newOperator": "{{syntax.control}}",
        "stringLiteral": "{{syntax.string}}",
        "customLiteral": "{{syntax.func}}",
        "numberLiteral": "{{syntax.number}}"
    }
}
